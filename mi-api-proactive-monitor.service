[Unit]
Description=MI-API cf_clearance proactive monitor (cf_refresher.py --proactive-monitor)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=REPLACE_WITH_YOUR_USER
WorkingDirectory=/REPLACE/WITH/PATH/TO/MI-API
ExecStart=/REPLACE/WITH/PATH/TO/MI-API/venv/bin/python /REPLACE/WITH/PATH/TO/MI-API/cf_refresher.py --proactive-monitor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
