ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

API_KEY=

API_DEBUG=False

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

CACHE_RECENT_EPISODES_HOURS=2
CACHE_EPISODES_HOURS=1

MIRURO_BASE_URL=

# curl_cffi browser TLS fingerprint to impersonate (bypasses Cloudflare bot detection). Example: chrome1XX
PIPE_IMPERSONATE=

PIPE_USER_AGENT=

PIPE_EXTRA_HEADERS={}

# --- Only needed on cloud nodes and any cf_refresher.py --listen fallback node (relay Telegram
# alerts through the home node, which is the only one with Hermes installed). Point this at the
# home node's ZeroTier address, e.g. http://<home-node-zerotier-ip>:8848. Leave unset on the home node.
NOTIFY_RELAY_URL=

# Human-readable label for this node (e.g. "cloud-1", "mac", "ubuntu-2"), appended to Telegram
# alerts as "[nodo: ...]". Falls back to the OS hostname if unset.
NODE_ID=

# Per-type Telegram alert opt-in (added 2026-09-09). Set the SAME values on every node — a node
# still on old code (no flag check at all) keeps sending every type unconditionally regardless
# of what you set here. Only NOTIFY_ON_ESCALATION defaults to true: it's the one alert that means
# "nobody fixed this automatically, a human needs to step in manually" — the other three fire on
# every single transient break/retry/recovery, which is normal operation, not something needing
# attention.
NOTIFY_ON_BREAK_DETECTED=false
NOTIFY_ON_ESCALATION=true
NOTIFY_ON_SOLVE_FAILURE=false
NOTIFY_ON_RECOVERY=false

# Only set on the home node — absolute path to the local Hermes CLI binary (hermes-agent's own
# venv). Any node where this is unset/missing falls through to NOTIFY_RELAY_URL instead.
HERMES_BIN_PATH=

# Isolates an entire group end to end — the cf_clearance cookie itself (its own Redis key,
# miruro_api:cf_clearance:{FALLBACK_TOPIC}), not just who gets woken up on a break. Set the SAME
# value here (api.py / the production node) and on every cf_refresher.py --listen node meant to
# answer for it; use a DIFFERENT value for another independent group so they never share a
# cookie or react to each other's breaks — e.g. "groupA" on this node plus one Ubuntu + the Mac,
# "groupB" on another production node plus a second Ubuntu + a Windows box. Never point two
# operationally-independent groups at the same topic just because a cookie happens to be valid
# from any IP (it is — the cookie is tied to the header set, not the IP) — sharing couples their
# fate together, confirmed live 2026-09-07 (see SESSION_LOG.md). Defaults to "default" (one
# shared group) if unset — fine for a single-group deployment.
FALLBACK_TOPIC=default

# --- Only relevant when running cf_refresher.py --listen (a fallback node — the Mac, an extra
# Ubuntu/Windows box, etc; not needed on the home node or plain cloud nodes) ---
# How often (seconds) to poll the shared "need a refresh" flag as a durable fallback for whenever
# this machine was asleep/offline when the instant pub/sub trigger was published. Default 1800.
FALLBACK_POLL_INTERVAL_SECONDS=1800

# How long cf_refresher.py waits, untouched, after launching a fully un-instrumented Chrome
# before attaching to pull the cookie. 20s confirmed working live; lower may work too but
# untested. Default 20 if unset.
NAKED_LAUNCH_WAIT_SECONDS=20

# A solved cf_clearance sometimes only gets partial trust from Cloudflare (passes "episodes" but
# fails "sources", confirmed live — not fixable by changing which resource is queried). Max
# number of fresh browser-launch attempts within one run_refresh_once call before giving up and
# alerting. Default 3 if unset.
MAX_SOLVE_ATTEMPTS=3

# Experiment (2026-09-09): the "sources" half of the cf_clearance verification canary is
# genuinely noisy for reasons unrelated to Cloudflare — Miruro sometimes just hasn't scraped a
# working source for that specific episode+provider combo yet, confirmed by the user's own
# separate anime app. Default "false" skips the sources check entirely (only "episodes" has to
# pass); set "true" to re-enable it if this experiment shows real cookie breaks slipping through
# undetected (already confirmed to happen at least once before this flag existed).
CANARY_CHECK_SOURCES=false
